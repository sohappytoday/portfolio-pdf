{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/theme-application.schema.json",
  "title": "Company theme application source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "mode", "companySlug", "artDirection", "system", "adapter", "fontLicense", "layout", "compliance"],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidenceIds", "derivation", "rationale"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^E[0-9]{2,}$" } },
        "derivation": { "type": "string", "enum": ["adopted", "accessibility-adjusted", "licensed-substitute"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "type": "string", "enum": ["blocked", "adapter-ready", "portfolio-ready"] },
    "mode": { "type": "string", "enum": ["adapter-proof", "portfolio-render"] },
    "companySlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "artDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "artifactSha256", "acceptancePath", "acceptanceSha256"],
      "properties": {
        "artifactPath": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/sha" },
        "acceptancePath": { "type": "string", "minLength": 1 },
        "acceptanceSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "coreSha256", "themeContractSha256", "pageMapSha256", "contentCombinedSha256"],
      "properties": {
        "manifestSha256": { "$ref": "#/$defs/sha" },
        "coreSha256": { "$ref": "#/$defs/sha" },
        "themeContractSha256": { "$ref": "#/$defs/sha" },
        "pageMapSha256": { "$ref": "#/$defs/sha" },
        "contentCombinedSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "variables", "modifierClasses"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha" },
        "variables": { "type": "object", "minProperties": 21, "additionalProperties": { "$ref": "#/$defs/variable" } },
        "modifierClasses": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^theme-[a-z0-9]+(?:-[a-z0-9]+)*$" } }
      }
    },
    "fontLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "status", "combinedSha256", "pageCount"],
      "properties": {
        "root": { "const": "result/layout" },
        "status": { "type": "string", "enum": ["missing", "available"] },
        "combinedSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "pageCount": { "type": "integer", "minimum": 0 }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changesCore", "changesContent", "changesSemanticDom", "usesRestrictedBrandAssets", "usesRemoteAssets", "copiesProductionCss", "overwritesExistingOutput"],
      "properties": {
        "changesCore": { "const": false },
        "changesContent": { "const": false },
        "changesSemanticDom": { "const": false },
        "usesRestrictedBrandAssets": { "const": false },
        "usesRemoteAssets": { "const": false },
        "copiesProductionCss": { "const": false },
        "overwritesExistingOutput": { "const": false }
      }
    }
  }
}

