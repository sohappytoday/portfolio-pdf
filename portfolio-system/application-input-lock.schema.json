{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/application-input-lock.schema.json",
  "title": "Applied portfolio immutable input lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "companySlug", "mode", "buildId", "capturedAt", "inputs", "pages", "combinedSha256"],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "companySlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "mode": { "type": "string", "enum": ["adapter-proof", "portfolio-render"] },
    "buildId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "capturedAt": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artDirection", "extractionAcceptance", "systemManifest", "core", "themeContract", "pageMap", "content", "adapter", "fontLicense", "renderer"],
      "properties": {
        "artDirection": { "$ref": "#/$defs/file" },
        "extractionAcceptance": { "$ref": "#/$defs/file" },
        "systemManifest": { "$ref": "#/$defs/file" },
        "core": { "$ref": "#/$defs/file" },
        "themeContract": { "$ref": "#/$defs/file" },
        "pageMap": { "$ref": "#/$defs/file" },
        "content": { "$ref": "#/$defs/file" },
        "adapter": { "$ref": "#/$defs/file" },
        "fontLicense": { "$ref": "#/$defs/file" },
        "renderer": { "$ref": "#/$defs/file" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contentSha256", "layoutSha256", "type", "density", "textProbes"],
        "properties": {
          "name": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "layoutSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "type": { "type": "string", "minLength": 1 },
          "density": { "type": "string", "enum": ["sparse", "balanced", "dense"] },
          "textProbes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "combinedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

