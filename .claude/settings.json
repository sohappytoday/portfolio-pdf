{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-codex-validator.ps1\" -Validator \"$CLAUDE_PROJECT_DIR/.codex/hooks/validate-portfolio-system.ps1\"",
            "timeout": 30,
            "statusMessage": "Validating portfolio-system contracts"
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-codex-validator.ps1\" -Validator \"$CLAUDE_PROJECT_DIR/.codex/hooks/validate-art-direction-workflow.ps1\"",
            "timeout": 30,
            "statusMessage": "Validating company art-direction workflow"
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-codex-validator.ps1\" -Validator \"$CLAUDE_PROJECT_DIR/.codex/hooks/validate-application-workflow.ps1\"",
            "timeout": 30,
            "statusMessage": "Validating company theme application workflow"
          }
        ]
      }
    ]
  }
}
